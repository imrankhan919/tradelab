NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Local Docker MongoDB (replica set, needed for transactions)
MONGO_URI=mongodb://localhost:27017/tradelab?directConnection=true
# For Atlas free cluster use the mongodb+srv:// string from the Atlas dashboard
JWT_SECRET=change-me-to-a-long-random-string
# Coins the platform trades (Binance symbols)
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
# Binance public market-data hosts (no API key needed)
BINANCE_REST=https://data-api.binance.vision
BINANCE_WS=wss://data-stream.binance.vision:443
# Which process roles run inside this one Node process
RUN_COLLECTOR=true
RUN_WORKERS=true
# Redis is optional. Leave empty to use the in-process price bus.
REDIS_URL=
# Trading bot. "mock" needs no key and works offline.
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
BOT_INTERVAL_MIN=15
